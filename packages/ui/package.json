{
  "name": "@animui/ui",
  "version": "0.1.0",
  "description": "Modern animated UI component library — motion-first, Tailwind-powered, zero-compromise.",
  "keywords": ["react", "ui", "components", "animation", "motion", "tailwind", "nextjs", "typescript", "component-library"],
  "author": "AnimUI",
  "license": "MIT",
  "homepage": "https://stealshadow.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/animui/animui"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": "./dist/styles.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build && npm run type-check"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=3.0.0",
    "lucide-react": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": { "optional": true },
    "lucide-react": { "optional": false }
  },
  "dependencies": {
    "motion": "^12.0.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "react-hook-form": "^7.54.0",
    "@hookform/resolvers": "^3.9.0",
    "zod": "^3.24.0",
    "lucide-react": "^1.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "rimraf": "^6.0.1"
  }
}
